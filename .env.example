# =============================================================================
# BouwFlow — omgevingsvariabelen
# Kopieer dit bestand naar .env.local en vul de waarden in.
# Zet NOOIT echte sleutels in git. .env.local wordt genegeerd door git.
# =============================================================================

# Supabase-project (Supabase Dashboard → Project Settings → API / Data API)
# Deze twee waarden zijn bedoeld voor de browser en mogen publiek zijn;
# de beveiliging wordt geregeld door Row Level Security in de database.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) — of de oudere "anon" key via
# NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Publieke URL van de applicatie (gebruikt in e-maillinks voor bevestiging)
# Lokaal: http://localhost:3000 — productie: https://app.uwdomein.sr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo-modus (alleen-lezen voorbeeldgegevens) wanneer Supabase NIET is ingesteld.
#   leeg  → aan tijdens ontwikkeling, uit in productie
#   true  → altijd aan (zonder Supabase)
#   false → altijd uit
# Zodra Supabase is ingesteld, wordt de demo-modus genegeerd.
BOUWFLOW_DEMO_MODE=

# LET OP: de Supabase service-role key (geheim) wordt in deze fase niet gebruikt.
# Gebruik hem nooit met een NEXT_PUBLIC_-prefix en nooit in browsercode.
